+            : require("@ff-labs/fff-bin-linux-x64-gnu/libfff_c.so");
+      } else if (process.platform === "win32") {
+        binaryPath = process.arch === "arm64"
+          ? require("@ff-labs/fff-bin-win32-arm64/fff_c.dll")
+          : require("@ff-labs/fff-bin-win32-x64/fff_c.dll");
+      }
+      return binaryPath && existsSync(binaryPath) ? binaryPath : null;
+    }
     // Use createRequire to resolve the platform package's location
