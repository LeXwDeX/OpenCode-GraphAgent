      "id": "pattern-bun-windows-shim",
      "type": "Pattern",
      "domain": "经验论",
      "properties": {
        "title": "WSL 下 npm 安装的 bun 是 Windows shim",
        "description": "npm 全局安装的 bun 是 shim 脚本转发到 bun.exe（process.platform=win32），构建 Linux 目标必须用真 Linux bun 前置 PATH",
        "status": "validated"
      },
      "weight": 2.5,
